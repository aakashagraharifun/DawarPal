# --- LLM (Groq) ---
# Free key: https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
# Model names start with "groq:". List what your key can use:
#   https://console.groq.com/docs/models
BOT_MODEL=groq:allam-2-7b
JUDGE_MODEL=groq:openai/gpt-oss-120b

# --- Database (Supabase) ---
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Server-only key: the "service_role" key (legacy, starts with eyJ…) or a secret key
# (sb_secret_…). NEVER the anon/publishable key, and never put this in the client.
# If both are empty, the server uses an in-memory store (dev only; refused in production).
SUPABASE_SERVICE_KEY=

# Protects GET /api/admin/export.csv (sent as the x-admin-token header).
# Use a long random string. If empty, the export endpoint is disabled (404).
ADMIN_TOKEN=

# Allowed browser origin for CORS (Vite dev server default shown)
CLIENT_ORIGIN=http://localhost:5173

# --- Optional tuning ---
PORT=3001
# Cap on Groq calls per minute (free tier ≈ 30 requests/min per model)
GROQ_MAX_PER_MINUTE=28
# Requests waiting beyond this are rejected as "busy" instead of queued
LLM_MAX_QUEUE=40
LLM_TIMEOUT_MS=45000
# Thinking models (e.g. gpt-oss) use part of max_tokens for hidden reasoning. This many
# extra tokens are allowed on top of the visible budget (bot 200 / judge 300) so replies
# aren't cut off. 0 = off.
LLM_REASONING_HEADROOM=800
# Per-session cooldowns
CHAT_COOLDOWN_MS=8000
GUESS_COOLDOWN_MS=5000

# Force IPv4 for outgoing requests (default true). Fixes "fetch failed" on networks
# where DNS returns only an IPv6 address that isn't reachable. Set false on IPv6-only hosts.
FORCE_IPV4=true

# DEV ONLY: print each new session's passwords to the SERVER console so you can
# test the guess flow. Ignored when NODE_ENV=production. Never reaches the client.
DEBUG_PASSWORDS=false
